library(DESeq2)
library(here)
library(tidyverse)
count_dir <- here("analysis", "data")
counts <- read.csv(file.path(count_dir, "processed_count_matrix.csv"), row.names = 1) %>% as.matrix()
genes <- read.csv(file.path(count_dir, "gene_annotation.tsv"), sep = "\t")
samples <- read.csv(file.path(count_dir, "sample_metadata.tsv"), sep = "\t")
# Normalized
counts <- vst(counts)
# Take top 500
gene_variance <- apply(counts, 1, var)
top500 <- names(sort(gene_variance, decreasing = TRUE))[1:500]
counts <- counts[top500,]
# PCA
pca <- prcomp(t(counts))
df <- data.frame(
pca$x,
samples$wpc
)
ggplot(df, aes(x = PC1, y = PC2, color = factor(samples.wpc))) +
geom_point()
var_explained <- round(100 * summary(pca)$importance[2, 1:2], 1)
df <- data.frame(pca$x[, 1:2], wpc = samples$wpc, sex = samples$sex) %>%
mutate(age_group = cut(wpc, breaks = c(0, 5, 8, 11, 13, Inf),
labels = c("4–5 wpc", "7–8 wpc", "9–11 wpc", "12–13 wpc", "16–19 wpc")))
# Mean PC1/PC2 per age group
group_means <- df %>%
group_by(age_group) %>%
summarise(PC1 = mean(PC1), PC2 = mean(PC2), n = n(), .groups = "drop")
ggplot(df, aes(PC1, PC2)) +
geom_point(aes(colour = wpc), size = 2.5, alpha = 0.8) +
geom_path(data = group_means, colour = "grey40",                       # connects means in age order
arrow = arrow(length = unit(0.25, "cm"), type = "closed")) +
geom_point(data = group_means, shape = 21, fill = "white", colour = "black",
size = 5, stroke = 1.2) +
geom_text(data = group_means, aes(label = age_group),
vjust = -1.4, size = 3.5, fontface = "bold") +
scale_colour_gradient(low = "#cde2fb", high = "#104281", name = "wpc") +
labs(title = "PCA of prenatal brain samples",
subtitle = "Small dots: samples. Circles: mean per age group, connected in developmental order",
x = paste0("PC1 (", var_explained[1], "%)"),
y = paste0("PC2 (", var_explained[2], "%)")) +
theme_minimal(base_size = 12) +
theme(panel.grid.minor = element_blank(), plot.title = element_text(face = "bold"))
samples
